# Copy this file to .env and fill in ONE key. Never commit .env.
#   copy .env.example .env      (Windows)

# ---- LLM (primary + fallbacks) ----------------------------------------
LLM_PROVIDER=gemini                 # gemini | anthropic | openai | ollama | extractive
LLM_FALLBACKS=extractive          # optional: "ollama,extractive" (local model is ~50s per answer on this laptop)

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional alternatives (the brief lists Claude / OpenAI)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.groq.com/openai/v1   # any OpenAI-compatible server

# Offline fallback through Ollama (already installed on the team laptop)
OLLAMA_MODEL=qwen2.5:1.5b

# ---- Embeddings ---------------------------------------------------------
EMBED_PROVIDER=local                # local (offline, sentence-transformers) | gemini | openai | none (BM25 only)
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5

# ---- Retrieval / chunking (defaults were tuned with scripts/eval.py) ---
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=6
# GATE_DENSE_MIN=0.52
# GATE_LEXICAL_MIN=0.34
# USE_RERANKER=0

# ---- Server -------------------------------------------------------------
# HOST=127.0.0.1                    # use 0.0.0.0 to let teammates on the same Wi-Fi connect
# PORT=8000
# UPLOAD_TOKEN=                     # set on a public deployment so strangers cannot replace the document
